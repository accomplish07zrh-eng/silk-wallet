<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Silk" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 系统启动页留白：冷启动只放我们自己的字标动画，避免出现两个位置不同的字标 -->
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
