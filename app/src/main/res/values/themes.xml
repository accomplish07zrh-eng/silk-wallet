<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BiometricPrompt 需要 AppCompat 主题；窗口底色与首页一致，冷启动不闪 -->
    <style name="Theme.Silk" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
