uniform float2 uSize;
uniform float uTime;
uniform float2 uTilt;
uniform float2 uMomentum;
uniform float2 uArtSize;
uniform float2 uWhaleSize;
uniform float2 uMaskSize;
uniform shader uOriginal;
uniform shader uCleanPatch;
uniform shader uWhale;
uniform shader uMasks;

const float TAU = 6.28318530718;
const int SCENE = 0;

// SILICON_PORTRAIT

float2 metric(float2 delta) {
    return delta * float2(1.586, 1.0);
}

float3 maskAt(float2 uv) {
    // RGB stores the character's occlusion, loose hair, and fingertip masks.
    return float3(uMasks.eval(clamp(uv, 0.0, 1.0) * uMaskSize).rgb);
}

float softLine(float x) {
    return exp(-x * x);
}

float life(float t) {
    return smoothstep(0.0, 0.19, t) * (1.0 - smoothstep(0.76, 1.0, t));
}

float2 whaleOrigin(float progress) {
    float phase = progress * TAU;
    float stroke = phase * 3.0 - 0.8;
    float dive = smoothstep(0.50, 0.97, progress);
    float glide = progress + 0.024 * sin(phase * 2.0);
    return float2(
        mix(0.58, -0.23, glide) + 0.014 * sin(stroke) + uTilt.x * 0.048,
        0.275 - 0.060 * sin(progress * 3.1415927) + 0.075 * dive + 0.009 * cos(stroke) + uTilt.y * 0.033);
}

float whaleScale(float progress) {
    return 0.88 + 0.17 * sin(progress * 3.1415927) - smoothstep(0.50, 0.97, progress) * 0.060;
}

float caustics(float2 uv, float phase) {
    float2 water = uv + uTilt * float2(0.086, 0.045) + uMomentum * float2(0.025, 0.018);
    float first = sin(water.x * 24.0 + water.y * 13.0 + sin(water.y * 22.0 - phase) * 1.1 + phase * 2.0);
    float second = sin(water.x * 12.0 - water.y * 26.0 + cos(water.x * 19.0 + phase) * 1.4 - phase);
    float seam = first + second * 0.60;
    float narrow = softLine(seam * 7.0);
    float crossing = softLine(second * 2.2);
    return narrow * (0.36 + 0.64 * crossing) + 0.18 * softLine((seam - 0.21) * 4.0) * crossing;
}

half4 main(float2 position) {
    float2 uv = position / uSize;
    float progress = fract(uTime / 12.0 + 0.34);
    float phase = progress * TAU;
    float2 artwork = fabricSample(uv, phase, uTilt, uMomentum, SCENE);
    // A continuous, sub-pixel-scale shift at the tip keeps the finger in one piece.
    float finger = portraitFalloff(uv, float2(0.768, 0.513), float2(0.020, 0.041), 0.22);
    if (finger > 0.0) {
        float swing = sin(phase * 2.0 + 0.3) + uTilt.x * 0.25 + uMomentum.x * 0.13;
        artwork += finger * float2(0.0023, -0.0007) * swing;
    }
    half4 original = uOriginal.eval(artwork * uArtSize);
    half4 patch = uCleanPatch.eval(artwork * uArtSize);
    half3 col = original.rgb * (1.0 - patch.a) + patch.rgb;
    float3 masks = maskAt(artwork);
    float openWater = 1.0 - masks.r;
    float depth = smoothstep(0.01, 0.18, progress) * (1.0 - smoothstep(0.78, 0.998, progress));

    // The whale emerges behind the character, then glides left into darker water.
    float dive = smoothstep(0.50, 0.97, progress);
    float stroke = phase * 3.0 - 0.8;
    float2 origin = whaleOrigin(progress);
    float scale = whaleScale(progress);
    float2 swimmer = (uv - origin) / (float2(0.735, 0.356) * scale);
    float2 currentUV = swimmer;
    float bend = smoothstep(0.28, 1.0, swimmer.x);
    float tailWave = stroke - swimmer.x * 4.2 + 0.8;
    swimmer.y += bend * bend * (sin(tailWave) * 0.27 + 0.024 * sin(tailWave * 2.0));
    swimmer.y += (swimmer.x - 0.24) * (0.12 + 0.085 * cos(phase) - dive * 0.11);
    swimmer.x += (1.0 - smoothstep(0.2, 0.8, swimmer.x)) * sin(phase * 3.0 + swimmer.y * 5.0) * 0.012;
    // The long pectoral fin rolls independently. Its root stays attached to the body.
    float fin = softLine((swimmer.x - 0.32 - (swimmer.y - 0.62) * 0.28) / 0.18)
        * smoothstep(0.48, 0.94, swimmer.y);
    swimmer.x += fin * (0.052 * sin(stroke - 1.3) + uTilt.x * 0.026);
    swimmer.y += fin * (0.062 * cos(stroke - 1.3) + uTilt.y * 0.028);
    if (swimmer.x >= 0.0 && swimmer.x <= 1.0 && swimmer.y >= 0.0 && swimmer.y <= 1.0) {
        half4 whale = uWhale.eval(swimmer * uWhaleSize);
        half3 blue = whale.rgb * mix(half3(0.86, 1.03, 1.10), half3(0.48, 0.72, 0.90), dive * 0.75)
            + half3(0.012, 0.053, 0.079) * whale.a;
        float backlight = 1.0 - smoothstep(0.06, 0.73, swimmer.y);
        float flash = softLine((swimmer.x - 0.32 - 0.36 * cos(phase * 2.0) - uTilt.x * 0.36) / 0.20);
        float reflected = caustics(uv * 0.82, phase);
        float lifted = 0.50 + 0.50 * cos(stroke - swimmer.x * 4.7);
        float flank = softLine((swimmer.y - 0.31 - 0.052 * sin(swimmer.x * 8.1)) / 0.16);
        blue += half3(0.12, 0.37, 0.50) * whale.a * backlight * (0.26 + 0.74 * flash)
            * (0.24 + reflected * 0.76) * (1.0 - dive * 0.56);
        blue += half3(0.11, 0.30, 0.38) * whale.a * flank * lifted * reflected * (1.0 - dive * 0.70);
        col = mix(col, col * (1.0 - whale.a) + blue, openWater * depth * 0.82);
    }

    // Sample the tail's earlier position along the wake, leaving each stroke in the water.
    if (currentUV.x > 0.77 && currentUV.x < 1.82 && openWater > 0.01 && depth > 0.001) {
        float age = max(0.0, currentUV.x - 0.94);
        float previous = max(0.0, progress - age * 0.23);
        float pastPhase = previous * TAU;
        float pastStroke = pastPhase * 3.0 - 4.2;
        float pastPitch = 0.12 + 0.085 * cos(pastPhase) - smoothstep(0.50, 0.97, previous) * 0.11;
        float tailHeight = 0.12 - 0.27 * sin(pastStroke) - 0.024 * sin(pastStroke * 2.0) - 0.71 * pastPitch;
        float wakeY = whaleOrigin(previous).y + (tailHeight + age * 0.21) * whaleScale(previous) * 0.356
            + age * uMomentum.y * 0.066;
        float displacement = uv.y - wakeY;
        float fade = smoothstep(0.77, 1.00, currentUV.x) * (1.0 - smoothstep(1.28, 1.82, currentUV.x));
        float spread = 0.012 + age * 0.059;
        float beat = 0.30 + 0.70 * pow(0.5 + 0.5 * cos(pastStroke), 3.0);
        float core = softLine((displacement + spread) / (0.015 + age * 0.028));
        float edge = softLine((displacement - spread) / (0.017 + age * 0.024));
        float air = softLine(displacement / (0.033 + age * 0.025));
        float flow = fade * beat * depth * openWater;
        col *= 1.0 - air * flow * 0.16;
        col += half3(0.092, 0.28, 0.40) * (core * 0.81 + edge * 0.49) * flow;
        col += half3(0.25, 0.51, 0.64) * core * caustics(uv * 1.12, phase) * flow * 0.35;
        // Small streaks detach from the widening wake and leave its center behind.
        float trail = softLine((displacement + spread * 1.55) / (0.015 + age * 0.019));
        float flecks = softLine(sin(age * 63.0 + displacement * 44.0 - pastPhase * 4.0) * 3.7);
        col += half3(0.18, 0.43, 0.51) * trail * flecks * flow * smoothstep(0.05, 0.34, age) * 0.37;
        float curl = displacement + spread * (1.46 + 0.25 * cos(pastStroke))
            - age * 0.018 * sin(age * 19.0 - pastStroke);
        float wakeRim = softLine(curl / (0.008 + age * 0.013)) * smoothstep(0.09, 0.40, age);
        col += half3(0.08, 0.31, 0.42) * wakeRim * flow * (0.32 + 0.55 * flecks);
    }

    // The existing hair mask catches a narrow highlight as the loose lock sways.
    float strands = masks.g * masks.r * portraitFalloff(uv, float2(0.532, 0.678), float2(0.150, 0.165), 0.28);
    float wave = phase * 2.0 + artwork.x * 15.0 - artwork.y * 12.0 + uTilt.x * 2.8;
    col += half3(0.031, 0.091, 0.14) * strands * softLine(sin(wave) * 2.5);

    // Light breaks at the surface and fans out through the open water.
    float shafts = 0.0;
    if (openWater > 0.008) {
        float2 source = float2(0.46 + uTilt.x * 0.085, -0.12 + uTilt.y * 0.055);
        float spread = (uv.x - source.x) / (uv.y - source.y + 0.12);
        float drift = 0.11 * sin(phase) + uTilt.x * 0.12 - uTilt.y * 0.08;
        float light = softLine((spread - drift + 0.40) / 0.11) * 0.61
            + softLine((spread - drift + 0.13) / 0.085) * 0.88
            + softLine((spread - drift - 0.14) / 0.072) * 0.40;
        float mist = 1.0 - smoothstep(0.05, 0.77, uv.y);
        float surface = 1.0 - smoothstep(0.04, 0.29, uv.y);
        float crossing = softLine((spread - drift + 0.18 + 0.22 * sin(phase - 0.5)) / 0.067);
        float horizon = (light + 0.41 * crossing) * mist * (0.68 + 0.32 * cos(phase));
        float scatter = caustics(uv, phase);
        shafts = horizon;
        col += half3(0.045, 0.153, 0.214) * openWater * (horizon + scatter * surface * 0.72);
        col += half3(0.076, 0.20, 0.24) * openWater * scatter * horizon * 0.23;

        // Waves crossing at the surface throw a bright, moving fan into the dark water.
        float crest = 0.09 * cos(phase * 2.0 - uv.y * 4.3) + uMomentum.x * 0.17;
        float refraction = spread - drift + 0.28 - crest;
        float fan = softLine(refraction / 0.18) - 0.65 * softLine((refraction - 0.023) / 0.065);
        float glimmer = softLine((refraction + 0.074) / 0.043) + 0.70 * softLine((refraction - 0.068) / 0.038);
        float beam = mist * (0.32 + 0.68 * pow(0.5 + 0.5 * cos(phase * 2.0 + uv.y * 4.0), 2.0));
        float veil = softLine((refraction + 0.22 + 0.036 * sin(uv.y * 17.0 - phase)) / 0.13);
        float brokenLight = softLine((refraction + 0.18) / 0.050) * scatter;
        col += half3(0.033, 0.134, 0.224) * openWater * beam * (0.70 * fan + glimmer * (0.48 + 0.52 * scatter));
        col += half3(0.028, 0.111, 0.174) * openWater * (0.57 * veil + 0.56 * brokenLight) * mist * (0.39 + 0.61 * beam);
    }

    // Bubbles at different depths rise at different speeds and catch the same light.
    if (uv.x < 0.71 && openWater > 0.01) {
        for (int i = 0; i < 11; i++) {
            float k = float(i);
            float near = fract(k * 0.618 + 0.39);
            float age = fract(phase / TAU * (i < 4 ? 1.0 : 2.0) + k * 0.371 + 0.16);
            float bx = 0.058 + fract(k * 0.733 + 0.24) * 0.54 + 0.022 * sin(age * TAU + k)
                + uTilt.x * (0.022 + near * 0.028) + uMomentum.x * near * 0.049;
            float by = 0.93 - age * (0.77 + 0.08 * near) + uTilt.y * 0.014 + uMomentum.y * near * 0.035;
            float2 bubble = metric(uv - float2(bx, by));
            float radius = 0.0026 + near * near * 0.011;
            if (max(abs(bubble.x), abs(bubble.y)) > radius * 1.9) continue;
            bubble.y *= 1.0 + 0.16 * sin(phase * 3.0 + k);
            float r = length(bubble);
            float rim = softLine((r - radius) / (0.0012 + radius * 0.09));
            float2 lightSide = float2(0.45 + 0.26 * uTilt.x, 0.52 + 0.22 * uTilt.y);
            float glare = softLine(length(bubble + radius * lightSide) / (radius * 0.33));
            float bounce = softLine(length(bubble - radius * lightSide) / (radius * 0.39));
            float edge = openWater * life(age) * (1.0 - smoothstep(0.63, 0.71, uv.x));
            if (near > 0.67 && r < radius) {
                float lens = 1.0 - smoothstep(radius * 0.43, radius * 0.99, r);
                float2 lensUV = clamp(artwork - bubble / float2(1.586, 1.0) * (0.62 + lens * 0.38), 0.0, 1.0);
                half4 refracted = uCleanPatch.eval(lensUV * uArtSize);
                half3 water = uOriginal.eval(lensUV * uArtSize).rgb * (1.0 - refracted.a) + refracted.rgb;
                col = mix(col, water * half3(0.83, 1.01, 1.08), lens * edge * 0.44);
            }
            col *= 1.0 - softLine(r / (radius * 0.76)) * edge * (0.13 + near * 0.13);
            col += half3(0.38, 0.74, 0.96)
                * (rim * (0.19 + near * 0.15) + glare * (0.42 + shafts * 0.36) + bounce * 0.18) * edge;
        }
    }

    // A compact shoal turns as the whale passes. Its silver flanks flash in sequence.
    if (uv.x < 0.62 && uv.y > 0.29 && uv.y < 0.59 && openWater > 0.02) {
        float schoolAge = fract(uTime / 12.0 + 0.86);
        float turnAway = softLine((progress - 0.45) / 0.145) * life(schoolAge);
        float2 school = float2(0.04 + schoolAge * 0.52, 0.53 - schoolAge * 0.22 + turnAway * 0.061)
            + uTilt * float2(0.032, 0.025) + uMomentum * float2(0.021, 0.014);
        float2 d = metric(uv - school);
        if (abs(d.x) < 0.13 && abs(d.y) < 0.069) {
            float strength = life(schoolAge) * openWater * (1.0 - smoothstep(0.55, 0.62, uv.x))
                * smoothstep(0.29, 0.32, uv.y) * (1.0 - smoothstep(0.55, 0.59, uv.y));
            for (int i = 0; i < 9; i++) {
                float k = float(i);
                float2 fish = d - float2((fract(k * 0.61 + 0.20) - 0.5) * (0.19 + 0.035 * turnAway),
                    (fract(k * 0.38 + 0.13) - 0.5) * (0.074 + 0.023 * turnAway) + 0.014 * sin(stroke + k * 0.7));
                if (abs(fish.x) > 0.016 || abs(fish.y) > 0.012) continue;
                float turning = sin(stroke + k * 0.47 + uTilt.x * 2.1 - turnAway * 1.8);
                fish.y += fish.x * (0.26 + 0.30 * turning);
                float flank = softLine(length(fish * float2(0.38, 1.0)) / 0.0028);
                float tail = softLine((fish.x + 0.008) / 0.0028) * softLine((abs(fish.y) - 0.0021) / 0.0017);
                float glint = (0.18 + 0.82 * turning * turning) * (0.69 + 0.48 * shafts);
                col += half3(0.28, 0.66, 0.83) * (flank * 0.66 + tail * 0.28) * glint * strength;
            }
        }
    }
    return half4(clamp(col, 0.0, 1.0), 1.0);
}
