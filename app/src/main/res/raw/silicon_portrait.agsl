const float PORTRAIT_TAU = 6.28318530718;

float portraitFalloff(float2 uv, float2 center, float2 radius, float core) {
    float2 p = (uv - center) / radius;
    return 1.0 - smoothstep(core * core, 1.0, dot(p, p));
}

float portraitGesture(float phase, float offset) {
    float t = fract(phase / PORTRAIT_TAU + offset);
    return smoothstep(0.10, 0.36, t) * (1.0 - smoothstep(0.50, 0.85, t));
}

float portraitFollowThrough(float phase, float offset) {
    float t = fract(phase / PORTRAIT_TAU + offset);
    float tail = smoothstep(0.40, 0.51, t) * (1.0 - smoothstep(0.67, 0.90, t));
    return sin((t - 0.44) * 16.0) * tail;
}

// These bounds cover one loose lock, tail tip or sleeve end in each original.
// Faces, hands and rigid props are outside the sampling region at every pose.
float2 fabricSample(float2 uv, float phase, float2 tilt, float2 momentum, int scene) {
    float2 center;
    float2 radius;
    float2 direction;
    if (scene == 14) {
        center = float2(0.532, 0.678);
        radius = float2(0.122, 0.136);
        direction = float2(0.0055, 0.0090);
    } else if (scene == 15) {
        center = float2(0.301, 0.635);
        radius = float2(0.094, 0.101);
        direction = float2(0.0055, 0.0100);
    } else if (scene == 16) {
        center = float2(0.188, 0.762);
        radius = float2(0.142, 0.113);
        direction = float2(0.0060, 0.0120);
    } else if (scene == 17) {
        center = float2(0.912, 0.371);
        radius = float2(0.084, 0.108);
        direction = float2(0.0070, 0.0105);
    } else if (scene == 18) {
        center = float2(0.227, 0.439);
        radius = float2(0.142, 0.119);
        direction = float2(0.0070, 0.0130);
    } else if (scene == 19) {
        center = float2(0.671, 0.604);
        radius = float2(0.117, 0.109);
        direction = float2(0.0080, 0.0110);
    } else if (scene == 20) {
        center = float2(0.829, 0.558);
        radius = float2(0.110, 0.130);
        direction = float2(0.0060, 0.0100);
    } else if (scene == 21) {
        center = float2(0.901, 0.591);
        radius = float2(0.098, 0.128);
        direction = float2(0.0060, 0.0120);
    } else if (scene == 22) {
        center = float2(0.838, 0.574);
        radius = float2(0.140, 0.120);
        direction = float2(0.0070, 0.0110);
    } else {
        center = float2(0.278, 0.347);
        radius = float2(0.124, 0.094);
        direction = float2(0.0060, 0.0100);
    }
    float weight = portraitFalloff(uv, center, radius, 0.26);
    if (weight <= 0.0) return uv;
    float wave = phase * 2.0 + float(scene) * 0.67 - (uv.x - center.x) * 5.0;
    float2 sway = float2(sin(wave), cos(wave + 0.31));
    float2 drag = clamp(tilt * 0.24 + momentum * 0.14, -0.38, 0.38);
    return uv + (sway + drag) * direction * weight;
}
